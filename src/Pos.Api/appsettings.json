{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "OutboxSettings": {
    "PollingIntervalSeconds": 10,
    "BatchSize": 20,
    "MaxRetries": 3,
    "BaseRetryIntervalSeconds": 2,
    "LeaseDurationSeconds": 60,
    "MessageTimeoutSeconds": 2
  },
  "InvoiceReconciliation": {
    "IntervalSeconds": 300,
    "ThresholdMinutes": 5,
    "MaxReconciliationAttempts": 5,
    "BatchSize": 50
  },
  "SuperAdminSettings": {
    "Email": "admin@enterprise.com",
    "FirstName": "Super",
    "LastName": "Admin"
  },
  "CorsSettings": {
    "AllowedOrigins": [
      "http://localhost:4200",
      "https://localhost:4200"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
