    "AuthPolicy": {
      "PermitLimit": 10,
      "WindowMinutes": 1,
      "QueueLimit": 0
    },
    "PosCheckoutPolicy": {
      "PermitLimit": 120,
      "WindowMinutes": 1,
      "SegmentsPerWindow": 6,
      "QueueLimit": 0
    },
    "SensitiveOperationsPolicy": {
      "PermitLimit": 60,
      "WindowMinutes": 1,
      "QueueLimit": 0
