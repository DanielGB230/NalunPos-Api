{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "OutboxSettings": {
    "PollingIntervalSeconds": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "RateLimiting": {
    "AuthPolicy": {
      "PermitLimit": 10,
      "WindowMinutes": 1,
      "QueueLimit": 0
    },
    "PosCheckoutPolicy": {
      "PermitLimit": 120,
      "WindowMinutes": 1,
      "SegmentsPerWindow": 6,
      "QueueLimit": 0
    },
    "SensitiveOperationsPolicy": {
      "PermitLimit": 60,
      "WindowMinutes": 1,
      "QueueLimit": 0
    },
    "GlobalApiPolicy": {
      "PermitLimit": 300,
      "WindowMinutes": 1,
      "QueueLimit": 0
    }
  }
}

